{
  "manifest_version": 3,
  "name": "RefCanvas Browser Capture",
  "version": "0.1.0",
  "description": "Right-click any image on the web and send it to a RefCanvas reference board.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["contextMenus", "activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:17530/*", "http://127.0.0.1:17530/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  }
}