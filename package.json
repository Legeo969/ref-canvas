{
  "name": "ref-canvas",
  "productName": "RefCanvas",
  "version": "0.38.4",
  "description": "A disk-native media browser and infinite reference canvas.",
  "main": ".vite/build/main.js",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": "24.15.x",
    "pnpm": "11.1.3"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "node scripts/build/make.cjs",
    "release:windows": "node scripts/build/release-windows.cjs",
    "native:openimageio": "node scripts/build/install-openimageio.cjs",
    "check": "pnpm check:repo && pnpm lint && pnpm typecheck && pnpm test",
    "check:repo": "node scripts/qa/repository-check.cjs",
    "lint": "eslint .",
    "check:release": "pnpm check && pnpm test:performance && pnpm test:capacity && pnpm package && pnpm test:runtime",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:architecture": "vitest run tests/architecture/layers.test.ts",
    "test:capacity": "vitest run --config vitest.capacity.config.ts",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "test:runtime": "node scripts/qa/runtime-smoke.cjs",
    "test:package": "node scripts/qa/package-smoke.cjs",
    "licenses": "node scripts/qa/licenses.cjs",
    "test:watch": "vitest"
  },
  "author": "RefCanvas",
  "license": "UNLICENSED",
  "dependencies": {
    "@ffprobe-installer/ffprobe": "2.1.2",
    "better-sqlite3": "13.0.2",
    "chokidar": "5.0.0",
    "exrs": "1.0.3",
    "fabric": "7.4.0",
    "ffmpeg-static": "5.3.0",
    "lucide-react": "0.468.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "three": "0.185.1",
    "tslib": "2.8.1",
    "zod": "4.1.12",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "43.2.0",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.2.4",
    "vitest": "4.0.13"
  }
}
