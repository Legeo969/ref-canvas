    addWatchFolder: () => ipcRenderer.invoke("library:add-watch-folder"),
    listWatchRoots: () => ipcRenderer.invoke("library:list-watch-roots"),
    removeWatchRoot: (id) =>
      ipcRenderer.invoke("library:remove-watch-root", id),
    setTags: (assetId, tags) =>
