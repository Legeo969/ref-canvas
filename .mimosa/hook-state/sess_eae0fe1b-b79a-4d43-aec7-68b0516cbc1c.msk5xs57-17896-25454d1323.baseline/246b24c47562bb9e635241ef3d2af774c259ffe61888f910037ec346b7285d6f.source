import { z } from "zod";
import {
  assetColorLabels,
  assetKinds,
  assetSortKeys,
} from "../../shared/contracts";

export const idSchema = z.string().uuid();
export const idsSchema = z.array(idSchema).min(1).max(10_000);
export const nativeDragIdsSchema = z.array(idSchema).min(1).max(500);
export const pathSchema = z.string().min(1).max(32_768);
export const pathsSchema = z.array(pathSchema).min(1).max(1000);
export const directoryPathsSchema = z.array(pathSchema).max(10_000);

export const searchObjectSchema = z.object({
  query: z.string().max(256).optional(),
  kind: z.enum([...assetKinds, "all"]).optional(),
  linkState: z
    .enum(["online", "missing", "searching", "ambiguous", "all"])
    .optional(),
  lifecycle: z.enum(["active", "trashed", "purged"]).optional(),
  pageSize: z.number().int().min(1).max(500).optional(),
  cursor: z.string().max(2048).optional(),
  limit: z.number().int().min(1).max(500).optional(),
  offset: z.number().int().min(0).optional(),
  tag: z.string().trim().min(1).max(64).optional(),
  favorite: z.boolean().optional(),
  ratingMin: z.number().int().min(0).max(5).optional(),
  colorLabel: z.enum(assetColorLabels).optional(),
  dominantColor: z.string().regex(/^#[0-9a-f]{6}$/i).optional(),
  colorTolerance: z.number().int().min(1).max(100).optional(),
  minWidth: z.number().int().min(0).max(1_000_000).optional(),
  maxWidth: z.number().int().min(0).max(1_000_000).optional(),
  minHeight: z.number().int().min(0).max(1_000_000).optional(),
  maxHeight: z.number().int().min(0).max(1_000_000).optional(),
  minSize: z.number().int().min(0).max(1_000_000_000_000_000).optional(),
  maxSize: z.number().int().min(0).max(1_000_000_000_000_000).optional(),
  minDuration: z.number().min(0).max(315_360_000).optional(),
  maxDuration: z.number().min(0).max(315_360_000).optional(),
  minBpm: z.number().min(0).max(1000).optional(),
  maxBpm: z.number().min(0).max(1000).optional(),
  extension: z.string().trim().regex(/^[a-z0-9]{1,16}$/i).optional(),
  orientation: z.enum(["landscape", "portrait", "square"]).optional(),
  includeTags: z.array(z.string().trim().min(1).max(64)).max(32).optional(),
  anyTags: z.array(z.string().trim().min(1).max(64)).max(32).optional(),
  excludeTags: z.array(z.string().trim().min(1).max(64)).max(32).optional(),
  pathContains: z.string().trim().min(1).max(512).optional(),
  filenameContains: z.string().trim().min(1).max(256).optional(),
  notesContains: z.string().trim().min(1).max(256).optional(),
  exactAspectRatio: z
    .string()
    .trim()
    .regex(/^\d+\s*[:：]\s*\d+$/)
    .max(16)
    .optional(),
  customFields: z
    .array(
      z.object({
        key: z.string().trim().min(1).max(64),
        value: z.string().max(256),
      }),
    )
    .max(32)
    .optional(),
  createdAfter: z.string().datetime().optional(),
  createdBefore: z.string().datetime().optional(),
  modifiedAfter: z.string().datetime().optional(),
  modifiedBefore: z.string().datetime().optional(),
  sort: z.enum(assetSortKeys).optional(),
  direction: z.enum(["asc", "desc"]).optional(),
});

export const searchSchema = searchObjectSchema.optional();
export const searchWindowSchema = z.object({
  query: searchObjectSchema,
  offset: z.number().int().min(0),
  pageSize: z.number().int().min(1).max(200),
  includeTotal: z.boolean(),
});
export const selectionSchema = z.union([
  z.object({ mode: z.literal("ids"), ids: idsSchema }),
  z.object({
    mode: z.literal("query"),
    query: searchObjectSchema,
    excludedIds: z.array(idSchema).max(10_000),
  }),
]);
