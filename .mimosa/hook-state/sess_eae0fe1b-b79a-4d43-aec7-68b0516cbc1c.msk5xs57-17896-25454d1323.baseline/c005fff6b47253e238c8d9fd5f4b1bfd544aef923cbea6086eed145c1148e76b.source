  BoardSettings,
  BoardSummary,
} from "../../shared/contracts";
import {
  clampOpacity,
  constrainedAxis,
  cropGestureRect,
  cropPanDelta,
  isMiddleButtonPointer,
  isPanPointerEvent,
  opacityDelta,
  normalizeSignedAngle,
  rotationForGesture,
  restoreRotationGesture,
  snapRotationAngle,
  scaleForGesture,
  zoomFactorForDrag,
} from "../app/board-gestures";
