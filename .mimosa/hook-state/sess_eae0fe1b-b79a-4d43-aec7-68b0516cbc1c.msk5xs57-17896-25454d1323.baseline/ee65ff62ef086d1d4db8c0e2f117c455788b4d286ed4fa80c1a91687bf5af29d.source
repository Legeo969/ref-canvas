import type {
  AssetColorLabel,
  AssetKind,
  AssetRecord,
  AssetSortKey,
  DuplicateGroup,
  ImportJobSnapshot,
  LibraryStats,
  LinkState,
  SavedView,
  SortDirection,
  TagGroupRecord,
  TagRecord,
} from "../../../shared/contracts";

export interface LibraryQuerySliceState {
  assets: AssetRecord[];
  assetWindowOffset: number;
  totalAssets: number;
  nextCursor: string | null;
  tags: TagRecord[];
  tagGroups: TagGroupRecord[];
  savedViews: SavedView[];
  duplicates: DuplicateGroup[];
  stats: LibraryStats;
  selectedAsset: AssetRecord | null;
  selectedIds: Set<string>;
  allMatchingSelected: boolean;
  excludedIds: Set<string>;
  selectionAnchorId: string | null;
  query: string;
  kindFilter: AssetKind | "all";
  linkStateFilter: LinkState | "all";
  lifecycleFilter: "active" | "trashed";
  favoriteFilter: boolean | undefined;
  ratingFilter: number;
  colorFilter: AssetColorLabel;
  visualColor: string | null;
  visualColorTolerance: number;
  minWidth: number | undefined;
  maxWidth: number | undefined;
  minHeight: number | undefined;
  maxHeight: number | undefined;
  minSize: number | undefined;
  maxSize: number | undefined;
  minDuration: number | undefined;
  maxDuration: number | undefined;
  extension: string | undefined;
  orientation: "landscape" | "portrait" | "square" | undefined;
  createdAfter: string | undefined;
  createdBefore: string | undefined;
  modifiedAfter: string | undefined;
  modifiedBefore: string | undefined;
  sort: AssetSortKey;
  direction: SortDirection;
  loading: boolean;
  loadingMore: boolean;
  importing: boolean;
  importJob: ImportJobSnapshot | null;
}

const emptyStats: LibraryStats = {
  total: 0,
  missing: 0,
  trashed: 0,
  favorites: 0,
  duplicates: 0,
  trashBytes: 0,
  byKind: {
    image: 0,
    video: 0,
    audio: 0,
    pdf: 0,
    model3d: 0,
    dcc: 0,
    font: 0,
    generic: 0,
  },
};

export function createLibraryQuerySliceState(): LibraryQuerySliceState {
  return {
    assets: [],
    assetWindowOffset: 0,
    totalAssets: 0,
    nextCursor: null,
    tags: [],
    tagGroups: [],
    savedViews: [],
    duplicates: [],
    stats: emptyStats,
    selectedAsset: null,
    selectedIds: new Set(),
    allMatchingSelected: false,
    excludedIds: new Set(),
    selectionAnchorId: null,
    query: "",
    kindFilter: "all",
    linkStateFilter: "all",
    lifecycleFilter: "active",
    favoriteFilter: undefined,
    ratingFilter: 0,
    colorFilter: "none",
    visualColor: null,
    visualColorTolerance: 25,
    minWidth: undefined,
    maxWidth: undefined,
    minHeight: undefined,
    maxHeight: undefined,
    minSize: undefined,
    maxSize: undefined,
    minDuration: undefined,
    maxDuration: undefined,
    extension: undefined,
    orientation: undefined,
    createdAfter: undefined,
    createdBefore: undefined,
    modifiedAfter: undefined,
    modifiedBefore: undefined,
    sort: "createdAt",
    direction: "desc",
    loading: true,
    loadingMore: false,
    importing: false,
    importJob: null,
  };
}
